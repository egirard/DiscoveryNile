{
  "name": "discovery-nile",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "prepare": "svelte-kit sync && husky || true",
    "dev": "VITE_RELAY_URL=${VITE_RELAY_URL:-ws://127.0.0.1:3001} VITE_DIAG_URL=${VITE_DIAG_URL:-http://127.0.0.1:3002} VITE_DICECAM_URL=${VITE_DICECAM_URL:-https://egirard.github.io/WebCamTool/dicecam/engine.js} vite dev --host 127.0.0.1 --port 3000 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4000 --strictPort",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "bun run build:e2e && playwright test",
    "test:e2e:update": "bun run build:e2e && playwright test --update-snapshots",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "relay": "bun run scripts/relay.ts",
    "verify:change": "bash scripts/verify-change.sh",
    "build:e2e": "VITE_E2E=true VITE_GIT_HASH=e2e-test-commit VITE_DEFAULT_BACKEND=local VITE_RELAY_URL=ws://127.0.0.1:3001 VITE_DICECAM_URL=/dicecam-stub.worker.js vite build",
    "test:e2e:only": "playwright test",
    "diag": "bun run scripts/diag-server.ts",
    "diag:context": "bun run scripts/diag-context.ts",
    "diag:reload": "bun run scripts/diag-reload.ts"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.17.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/bun": "^1.2.0",
    "@types/qrcode": "^1.5.5",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "svelte": "^5.20.0",
    "svelte-check": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  }
}
