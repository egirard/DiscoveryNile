index 0000000..98ab02d
--- /dev/null
+++ b/src/routes/embed/+page.svelte
@@ -0,0 +1,99 @@
+<script lang="ts">
+	/**
+	 * DiceCAM — Embed route (/embed)
+	 *
+	 * The dicecam for another game's table: the live feed with the detection overlay and
+	 * nothing else, made for an `<iframe allow="camera">` on a page of another origin. Every
+	 * dice event the detection pipeline dispatches on this document is re-posted to the
+	 * embedding window as a plain message (DiscoveryNile's docs/dicecam.md is the consumer):
+	 *
+	 *   { dicecam: 'ready' }                                 once this page is up
+	 *   { dicecam: 'camera', status }                        on every camera state change
+	 *   { dicecam: 'rolling' }                               motion: a throw is under way
+	 *   { dicecam: 'removed', remaining }                    dice taken out of the tray
+	 *   { dicecam: 'settled', rollId, dice: [{ value, confidence, askew }] }   left to right
+	 *
+	 * Messages go to the parent with target origin '*': they carry nothing private, and the
+	 * embedding page is expected to accept only messages whose `source` is its own frame.
+	 * Camera consent and recovery are VideoDisplay's as on /yahtzee (Phase 37).
+	 */
+	import { onMount, onDestroy } from 'svelte';
+	import { browser } from '$app/environment';
+	import { diceEvents } from '$lib/events';
+	import VideoDisplay from '$components/VideoDisplay.svelte';
+	import DiceOverlay from '$components/DiceOverlay.svelte';
+	import { cameraState, getVideoElement } from '$lib/stores/camera';
+	import { startMotionDetection, stopMotionDetection } from '$lib/stores/motion';
+	import { startDetection, stopDetection } from '$lib/stores/detection';
+
+	let videoElement: HTMLVideoElement | null = $state(null);
+
+	const post = (message: Record<string, unknown>) => {
+		if (!browser || window.parent === window) return;
+		window.parent.postMessage(message, '*');
+	};
+
+	// Pipeline lifecycle tied to camera-active, as /yahtzee does it (D-02): rendering
+	// <VideoDisplay /> starts the camera flow; this route only reacts to cameraState.
+	const unsubscribeCamera = cameraState.subscribe((value) => {
+		post({ dicecam: 'camera', status: value.status });
+		if (value.status === 'active') {
+			videoElement = getVideoElement();
+			if (videoElement) {
+				startMotionDetection(videoElement);
+				startDetection(videoElement);
+			}
+		} else {
+			videoElement = null;
+			stopMotionDetection();
+			stopDetection();
+		}
+	});
+
+	let unsubscribeDice: (() => void) | null = null;
+
+	onMount(() => {
+		unsubscribeDice = diceEvents.subscribe({
+			onRolling: () => post({ dicecam: 'rolling' }),
+			onRemoved: (payload) => post({ dicecam: 'removed', remaining: payload.remainingCount }),
+			onSettled: (payload) =>
+				post({
+					dicecam: 'settled',
+					rollId: payload.rollId,
+					dice: payload.dice.map((d) => ({ value: d.value, confidence: d.confidence, askew: d.askew === true }))
+				})
+		});
+		post({ dicecam: 'ready' });
+	});
+
+	onDestroy(() => {
+		unsubscribeCamera();
+		unsubscribeDice?.();
+		stopMotionDetection();
+		stopDetection();
+	});
+</script>
+
+<svelte:head>
+	<title>DiceCAM</title>
+</svelte:head>
+
+<main class="embed">
+	<div class="stage">
+		<VideoDisplay />
+		<DiceOverlay visible={true} video={videoElement} />
+	</div>
+</main>
+
+<style>
+	.embed {
+		width: 100%;
+		height: 100%;
+		background: #0a0a0a;
+	}
+	.stage {
+		position: relative;
+		width: 100%;
+		height: 100%;
+	}
+</style>
